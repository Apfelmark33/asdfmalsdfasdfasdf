  <diagram id="service-levels" name="3 Service Levels und SLA">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="sla-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=0;fontColor=#5F4216;fontFamily=Calibri;" value="Service Levels und SLA-Regeln" vertex="1">
          <mxGeometry x="60" y="20" width="1250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sla-sub" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#8B6130;fontFamily=Calibri;" value="SLA = verbindliches Ziel für Reaktion und Lösung" vertex="1">
          <mxGeometry x="60" y="70" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sla-p1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7E6E6;strokeColor=#5F4216;fontColor=#000000;fontSize=13;fontStyle=1;fontFamily=Calibri;" value="HOCH&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Reaktion: 1 Stunde&lt;br&gt;Lösung: 4 Stunden&lt;br&gt;Statusmeldung: stündlich&lt;/font&gt;" vertex="1">
          <mxGeometry x="90" y="145" width="390" height="125" as="geometry" />
        </mxCell>
        <mxCell id="sla-p2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E7E6E6;strokeColor=#8CA614;fontColor=#000000;fontSize=13;fontStyle=1;fontFamily=Calibri;" value="MITTEL&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Reaktion: 4 Stunden&lt;br&gt;Lösung: 2 Arbeitstage&lt;br&gt;Statusmeldung: bei Änderungen&lt;/font&gt;" vertex="1">
          <mxGeometry x="605" y="145" width="390" height="125" as="geometry" />
        </mxCell>
        <mxCell id="sla-p3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8CA614;fontColor=#000000;fontSize=13;fontStyle=1;fontFamily=Calibri;" value="NIEDRIG&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Reaktion: 1–2 Arbeitstage&lt;br&gt;Lösung: 5 Arbeitstage&lt;br&gt;Statusmeldung: bei Bearbeitung und Abschluss&lt;/font&gt;" vertex="1">
          <mxGeometry x="1120" y="145" width="390" height="125" as="geometry" />
        </mxCell>
        <mxCell id="sla-impact" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B6130;fontColor=#000000;align=left;verticalAlign=top;spacingTop=10;spacingLeft=10;fontSize=12;fontFamily=Calibri;" value="&lt;b&gt;AUSWIRKUNG&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hoch: Standort oder viele User&lt;br&gt;Mittel: mehrere User&lt;br&gt;Niedrig: ein User" vertex="1">
          <mxGeometry x="90" y="335" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="sla-plus" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=0;fontColor=#5F4216;fontFamily=Calibri;" value="+" vertex="1">
          <mxGeometry x="445" y="375" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sla-urgency" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B6130;fontColor=#000000;align=left;verticalAlign=top;spacingTop=10;spacingLeft=10;fontSize=12;fontFamily=Calibri;" value="&lt;b&gt;DRINGLICHKEIT&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hoch: Arbeit unmöglich&lt;br&gt;Mittel: Arbeit eingeschränkt&lt;br&gt;Niedrig: planbar / geringe Auswirkung" vertex="1">
          <mxGeometry x="530" y="335" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="sla-arrow" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#8B6130;fontFamily=Calibri;" value="ergibt" vertex="1">
          <mxGeometry x="885" y="375" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sla-matrix" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F4216;fontColor=#000000;fontSize=13;fontStyle=1;fontFamily=Calibri;" value="&lt;b&gt;PRIORITÄTSMATRIX&lt;/b&gt;&lt;br&gt;&lt;br&gt;Auswirkung / Dringlichkeit&amp;nbsp;&amp;nbsp;&amp;nbsp;HOCH&amp;nbsp;&amp;nbsp;&amp;nbsp;MITTEL&amp;nbsp;&amp;nbsp;&amp;nbsp;NIEDRIG&lt;br&gt;Hoch&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Hoch&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Hoch&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Mittel&lt;br&gt;Mittel&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Hoch&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Mittel&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Mittel&lt;br&gt;Niedrig&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Mittel&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Mittel&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Niedrig" vertex="1">
          <mxGeometry x="1000" y="320" width="510" height="180" as="geometry" />
        </mxCell>
        <mxCell id="sla-hours" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7E6E6;strokeColor=#8B6130;fontColor=#000000;fontSize=13;fontStyle=1;fontFamily=Calibri;" value="&lt;b&gt;SERVICEZEITEN – ANNAHME&lt;/b&gt;&lt;br&gt;Montag bis Freitag, 08:00–17:00 Uhr, Feiertage ausgenommen.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Muss vor Einführung von der IT bestätigt werden.&lt;/font&gt;" vertex="1">
          <mxGeometry x="90" y="555" width="620" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sla-clock" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7E6E6;strokeColor=#8B6130;fontColor=#000000;fontSize=13;fontStyle=1;fontFamily=Calibri;" value="&lt;b&gt;START UND ENDE&lt;/b&gt;&lt;br&gt;Start: Eingang des Tickets&lt;br&gt;Reaktion erfüllt: erste qualifizierte IT-Antwort&lt;br&gt;Lösung erfüllt: Status „Gelöst“" vertex="1">
          <mxGeometry x="790" y="555" width="720" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sla-rules" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B6130;fontColor=#000000;align=left;verticalAlign=top;spacingTop=10;spacingLeft=10;fontSize=12;fontFamily=Calibri;" value="&lt;b&gt;SLA-REGELN&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Automatische Eingangsbestätigung zählt nicht als Reaktion.&lt;br&gt;2. Bei „Wartet auf User“ oder „Wartet auf Genehmigung“ pausiert die Lösungszeit.&lt;br&gt;3. Bei 75 % der Zeit erhält der Bearbeiter eine Warnung.&lt;br&gt;4. Bei 100 % wird das Ticket eskaliert und als „SLA überschritten“ markiert.&lt;br&gt;5. Lehnt der User die Lösung ab, wird das Ticket wieder geöffnet und die Zeit läuft weiter.&lt;br&gt;6. Die IT darf eine Priorität nur mit dokumentierter Begründung ändern." vertex="1">
          <mxGeometry x="90" y="705" width="1420" height="205" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="roles-guide" name="6 Rollen und Arbeitsanweisung">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="g-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=0;fontColor=#5F4216;fontFamily=Calibri;" value="Rollen und Arbeitsanweisungen" vertex="1">
          <mxGeometry x="60" y="20" width="1250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="g-sub" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#8B6130;fontFamily=Calibri;" value="Wer muss wann was tun?" vertex="1">
          <mxGeometry x="60" y="70" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="g-user-lane" parent="1" style="swimlane;html=1;horizontal=0;startSize=55;fillColor=#8CA614;swimlaneFillColor=#FFFFFF;strokeColor=#8CA614;fontStyle=1;fontSize=16;rounded=0;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontFamily=Calibri;" value="USER" vertex="1">
          <mxGeometry x="40" y="120" width="470" height="800" as="geometry" />
        </mxCell>
        <mxCell id="g-it-lane" parent="1" style="swimlane;html=1;horizontal=0;startSize=55;fillColor=#8B6130;swimlaneFillColor=#FFFFFF;strokeColor=#8B6130;fontStyle=1;fontSize=16;rounded=0;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontFamily=Calibri;" value="IT" vertex="1">
          <mxGeometry x="510" y="120" width="590" height="800" as="geometry" />
        </mxCell>
        <mxCell id="g-admin-lane" parent="1" style="swimlane;html=1;horizontal=0;startSize=55;fillColor=#5F4216;swimlaneFillColor=#E7E6E6;strokeColor=#5F4216;fontStyle=1;fontSize=16;rounded=0;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontFamily=Calibri;" value="ADMIN" vertex="1">
          <mxGeometry x="1100" y="120" width="460" height="800" as="geometry" />
        </mxCell>
        <mxCell id="g-user-steps" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B6130;fontColor=#000000;align=left;verticalAlign=top;spacingTop=10;spacingLeft=10;fontSize=12;fontFamily=Calibri;" value="&lt;b&gt;BEI EINER STÖRUNG ODER ANFRAGE&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Passenden IT-Service auswählen.&lt;br&gt;2. Incident oder Service Request auswählen.&lt;br&gt;3. Alle Pflichtfelder vollständig ausfüllen.&lt;br&gt;4. Fehlermeldung oder Screenshot ergänzen.&lt;br&gt;5. Ticket absenden und Ticketnummer notieren.&lt;br&gt;6. Rückfragen der IT beantworten.&lt;br&gt;7. Vorgeschlagene Lösung testen.&lt;br&gt;8. „Gelöst“ bestätigen oder Problem beschreiben.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Bei Telefon oder persönlicher Meldung darf der Service Desk das Ticket stellvertretend erfassen.&lt;/font&gt;" vertex="1">
          <mxGeometry x="95" y="185" width="360" height="420" as="geometry" />
        </mxCell>
        <mxCell id="g-user-see" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8CA614;fontColor=#000000;fontSize=13;fontStyle=1;fontFamily=Calibri;" value="&lt;b&gt;DER USER SIEHT&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Ticketnummer und Erstellungszeit&lt;br&gt;• Status und Priorität&lt;br&gt;• öffentliche IT-Antworten&lt;br&gt;• zuständiges Team&lt;br&gt;• Lösung und Abschluss" vertex="1">
          <mxGeometry x="95" y="640" width="360" height="190" as="geometry" />
        </mxCell>
        <mxCell id="g-it-steps" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7E6E6;strokeColor=#8B6130;fontColor=#000000;fontSize=13;fontStyle=1;fontFamily=Calibri;" value="&lt;b&gt;BEI JEDEM NEUEN TICKET&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Vollständigkeit und Ticketart prüfen.&lt;br&gt;2. Service, Duplikate, Priorität und SLA prüfen.&lt;br&gt;3. Team und Bearbeiter zuweisen.&lt;br&gt;4. Erste qualifizierte Antwort senden.&lt;br&gt;5. Incident: Standardlösung anwenden oder analysieren und eskalieren.&lt;br&gt;6. Request: Genehmigung prüfen und Standardarbeitsanweisung ausführen.&lt;br&gt;7. Funktion beziehungsweise Ergebnis testen.&lt;br&gt;8. Maßnahmen, Status und Lösung dokumentieren.&lt;br&gt;9. User informieren und Rückmeldung abwarten.&lt;br&gt;10. Bei Ablehnung weiterbearbeiten, sonst schließen." vertex="1">
          <mxGeometry x="570" y="185" width="470" height="430" as="geometry" />
        </mxCell>
        <mxCell id="g-it-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F4216;fontColor=#000000;fontSize=13;fontStyle=1;fontFamily=Calibri;" value="&lt;b&gt;WICHTIG&lt;/b&gt;&lt;br&gt;&lt;br&gt;Öffentliche Kommentare sind für den User sichtbar.&lt;br&gt;Interne Notizen sind nur für die IT sichtbar.&lt;br&gt;Eine Prioritätsänderung benötigt eine Begründung." vertex="1">
          <mxGeometry x="570" y="675" width="470" height="155" as="geometry" />
        </mxCell>
        <mxCell id="g-admin-steps" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B6130;fontColor=#000000;align=left;verticalAlign=top;spacingTop=10;spacingLeft=10;fontSize=12;fontFamily=Calibri;" value="&lt;b&gt;VOR DEM BETRIEB&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Services und Kategorien pflegen.&lt;br&gt;2. Incident- und Request-Typen zuordnen.&lt;br&gt;3. Pflichtfelder festlegen.&lt;br&gt;4. Teams und Zuständigkeiten hinterlegen.&lt;br&gt;5. SLA-Ziele und Servicezeiten bestätigen.&lt;br&gt;6. Genehmigungen definieren.&lt;br&gt;7. Rollen und Berechtigungen vergeben.&lt;br&gt;8. Benachrichtigungen konfigurieren.&lt;br&gt;9. Testtickets durchführen.&lt;br&gt;10. Kennzahlen regelmäßig kontrollieren." vertex="1">
          <mxGeometry x="1150" y="185" width="360" height="430" as="geometry" />
        </mxCell>
        <mxCell id="g-sources" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F4216;fontColor=#000000;fontSize=13;fontStyle=1;fontFamily=Calibri;" value="&lt;b&gt;GRUNDLAGEN AUS DEM GEMEINSCHAFTSPROJEKT&lt;/b&gt;&lt;br&gt;&lt;br&gt;Kenneth: Services und Kategorien&lt;br&gt;Finn: Incidents, Prioritäten und Testtickets&lt;br&gt;Anna: Standardanfragen und Pflichtfelder&lt;br&gt;Mark: Gesamtprozess, Rollen, SLA und Systembeschreibung&lt;br&gt;Erion: Tests, Feedback und Verbesserungen" vertex="1">
          <mxGeometry x="1150" y="675" width="360" height="155" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ticket-operations" name="7 Ticketdaten und Betrieb">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="op-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=0;fontColor=#5F4216;fontFamily=Calibri;" value="Ticketdaten, Status und laufender Betrieb" vertex="1">
          <mxGeometry x="60" y="20" width="1250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="op-sub" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#8B6130;fontFamily=Calibri;" value="Diese Regeln gelten unabhängig davon, über welchen Kanal ein Ticket eingeht" vertex="1">
          <mxGeometry x="60" y="70" width="1100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="op-fields" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B6130;fontColor=#000000;align=left;verticalAlign=top;spacingTop=10;spacingLeft=10;fontSize=12;fontFamily=Calibri;" value="&lt;b&gt;PFLICHTDATEN JE TICKET&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Ticketnummer und Ticketart&lt;br&gt;• Ersteller und betroffene Person&lt;br&gt;• Service und Kategorie&lt;br&gt;• Kurzbeschreibung und Details&lt;br&gt;• Auswirkung, Dringlichkeit und Priorität&lt;br&gt;• Status, Team und Bearbeiter&lt;br&gt;• Erstellung, letzte Änderung und SLA-Zeiten&lt;br&gt;• öffentliche Kommentare und interne Notizen&lt;br&gt;• Anhänge, Lösung und Abschlussgrund&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Incident zusätzlich: Beginn, Betroffene, Arbeitsfähigkeit.&lt;br&gt;Request zusätzlich: gewünschter Termin, Genehmiger.&lt;/font&gt;" vertex="1">
          <mxGeometry x="60" y="145" width="460" height="350" as="geometry" />
        </mxCell>
        <mxCell id="op-status" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F4216;fontColor=#000000;fontSize=13;fontStyle=1;fontFamily=Calibri;" value="&lt;b&gt;ERLAUBTE STATUS&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Neu&lt;/b&gt; – noch nicht geprüft&lt;br&gt;&lt;b&gt;Zugewiesen&lt;/b&gt; – Team oder Bearbeiter festgelegt&lt;br&gt;&lt;b&gt;In Bearbeitung&lt;/b&gt; – aktive Diagnose oder Erfüllung&lt;br&gt;&lt;b&gt;Wartet auf User&lt;/b&gt; – Rückfrage offen, Lösungszeit pausiert&lt;br&gt;&lt;b&gt;Wartet auf Genehmigung&lt;/b&gt; – nur Request, Zielzeit pausiert&lt;br&gt;&lt;b&gt;Gelöst / Erfüllt&lt;/b&gt; – User soll Ergebnis prüfen&lt;br&gt;&lt;b&gt;Abgelehnt / Abgebrochen&lt;/b&gt; – mit Begründung beendet&lt;br&gt;&lt;b&gt;Geschlossen&lt;/b&gt; – bestätigt und nicht mehr bearbeitbar&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Lehnt der User die Lösung ab, wechselt das Ticket zurück zu „In Bearbeitung“.&lt;/font&gt;" vertex="1">
          <mxGeometry x="570" y="145" width="460" height="350" as="geometry" />
        </mxCell>
        <mxCell id="op-queues" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7E6E6;strokeColor=#8B6130;fontColor=#000000;fontSize=13;fontStyle=1;fontFamily=Calibri;" value="&lt;b&gt;IT-WARTESCHLANGEN&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Neue Tickets&lt;br&gt;2. Nicht zugewiesen&lt;br&gt;3. Meine Tickets&lt;br&gt;4. Hohe Priorität&lt;br&gt;5. SLA-Warnung&lt;br&gt;6. SLA überschritten&lt;br&gt;7. Wartet auf IT&lt;br&gt;8. Wartet auf User&lt;br&gt;9. Wartet auf Genehmigung&lt;br&gt;10. Gelöst – Bestätigung offen&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Sortierung: zuerst SLA-Restzeit, danach Priorität und Eingangszeit.&lt;/font&gt;" vertex="1">
          <mxGeometry x="1080" y="145" width="460" height="350" as="geometry" />
        </mxCell>
        <mxCell id="op-notify" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8CA614;fontColor=#000000;fontSize=13;fontStyle=1;fontFamily=Calibri;" value="&lt;b&gt;BENACHRICHTIGUNGEN&lt;/b&gt;&lt;br&gt;&lt;br&gt;Der User wird informiert bei:&lt;br&gt;• Eingang und Ticketnummer&lt;br&gt;• öffentlicher IT-Antwort oder Rückfrage&lt;br&gt;• Statusänderung&lt;br&gt;• Genehmigung oder Ablehnung&lt;br&gt;• Lösung beziehungsweise Erfüllung&lt;br&gt;• automatischem Abschluss&lt;br&gt;&lt;br&gt;Die IT wird informiert bei:&lt;br&gt;• neuer Zuweisung&lt;br&gt;• User-Antwort&lt;br&gt;• 75 % der SLA-Zeit&lt;br&gt;• SLA-Überschreitung" vertex="1">
          <mxGeometry x="60" y="550" width="700" height="285" as="geometry" />
        </mxCell>
        <mxCell id="op-report" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7E6E6;strokeColor=#8B6130;fontColor=#000000;fontSize=13;fontStyle=1;fontFamily=Calibri;" value="&lt;b&gt;AUSWERTUNG UND VERBESSERUNG&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mindestens monatlich auswerten:&lt;br&gt;• Tickets nach Service, Typ und Priorität&lt;br&gt;• durchschnittliche Reaktions- und Lösungszeit&lt;br&gt;• SLA eingehalten / überschritten&lt;br&gt;• wiedereröffnete Tickets&lt;br&gt;• häufig wiederkehrende Incidents&lt;br&gt;• abgelehnte Requests&lt;br&gt;• User-Feedback beziehungsweise Zufriedenheit&lt;br&gt;&lt;br&gt;Wiederkehrende Incidents werden als mögliches Problem markiert. Erion verwendet diese Werte für Tests und Verbesserungsvorschläge." vertex="1">
          <mxGeometry x="820" y="550" width="720" height="285" as="geometry" />
        </mxCell>
        <mxCell id="op-rule" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F4216;fontColor=#000000;fontSize=13;fontStyle=1;fontFamily=Calibri;" value="&lt;b&gt;GRUNDREGEL:&lt;/b&gt; Jede Änderung an Status, Priorität, Zuweisung, Genehmigung oder Lösung wird mit Zeitpunkt und verantwortlicher Person im Verlauf gespeichert." vertex="1">
          <mxGeometry x="270" y="875" width="1060" height="65" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="acceptance-tests" name="8 Tests und Abnahme">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="test-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=0;fontColor=#5F4216;fontFamily=Calibri;" value="Testfälle und Abnahmekriterien" vertex="1">
          <mxGeometry x="60" y="20" width="1250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="test-sub" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#8B6130;fontFamily=Calibri;" value="Mit diesen Fällen wird geprüft, ob Prozess, Rollen und Service Levels verständlich funktionieren" vertex="1">
          <mxGeometry x="60" y="70" width="1100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="test-left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B6130;fontColor=#000000;align=left;verticalAlign=top;spacingTop=10;spacingLeft=10;fontSize=12;fontFamily=Calibri;" value="&lt;b&gt;TESTFÄLLE 1–4: INCIDENTS&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Kritischer Ausfall&lt;/b&gt;&lt;br&gt;Viele User können nicht arbeiten. Erwartung: Priorität Hoch, sofortige Zuweisung, Reaktionsziel 1 Stunde.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Einzelner User mit Umgehungslösung&lt;/b&gt;&lt;br&gt;Erwartung: Auswirkung Niedrig, Dringlichkeit Mittel, Priorität Mittel.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Bekannte Störung&lt;/b&gt;&lt;br&gt;Erwartung: passende Standardlösung wird verwendet, getestet und dokumentiert.&lt;br&gt;&lt;br&gt;&lt;b&gt;4. Unbekannte Störung&lt;/b&gt;&lt;br&gt;Erwartung: Diagnose, dokumentierte Eskalation und Rückgabe der Lösung an den Service Desk." vertex="1">
          <mxGeometry x="60" y="145" width="710" height="440" as="geometry" />
        </mxCell>
        <mxCell id="test-right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B6130;fontColor=#000000;align=left;verticalAlign=top;spacingTop=10;spacingLeft=10;fontSize=12;fontFamily=Calibri;" value="&lt;b&gt;TESTFÄLLE 5–8: SERVICE REQUESTS&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;5. Vorab genehmigter Request&lt;/b&gt;&lt;br&gt;Erwartung: keine Genehmigungswartezeit; Standardarbeitsanweisung startet direkt.&lt;br&gt;&lt;br&gt;&lt;b&gt;6. Genehmigung erforderlich&lt;/b&gt;&lt;br&gt;Erwartung: Status „Wartet auf Genehmigung“, pausierte Zielzeit, danach Erfüllung.&lt;br&gt;&lt;br&gt;&lt;b&gt;7. Request abgelehnt&lt;/b&gt;&lt;br&gt;Erwartung: Begründung für User, Status „Abgelehnt“, keine Erfüllung.&lt;br&gt;&lt;br&gt;&lt;b&gt;8. Unvollständige Angaben&lt;/b&gt;&lt;br&gt;Erwartung: Rückfrage an User; nach Ergänzung wird dieselbe Anfrage weitergeführt." vertex="1">
          <mxGeometry x="830" y="145" width="710" height="440" as="geometry" />
        </mxCell>
        <mxCell id="test-accept" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F4216;fontColor=#000000;fontSize=13;fontStyle=1;fontFamily=Calibri;" value="&lt;b&gt;ABNAHMEKRITERIEN – ALLE MÜSSEN ERFÜLLT SEIN&lt;/b&gt;&lt;br&gt;&lt;br&gt;□ Jedes Ticket besitzt Nummer, Zeitstempel, Typ, Service, Status, Zuständigkeit und Verlauf.&lt;br&gt;□ Der User sieht öffentliche Antworten, aber keine internen IT-Notizen.&lt;br&gt;□ Priorität entsteht nachvollziehbar aus Auswirkung und Dringlichkeit.&lt;br&gt;□ Reaktions- und Lösungsziele werden getrennt gemessen.&lt;br&gt;□ SLA-Pause und Wiederaufnahme funktionieren gemäß den dokumentierten Regeln.&lt;br&gt;□ Ein Request mit Genehmigung kann nicht vor der Freigabe erfüllt werden.&lt;br&gt;□ Ein ungelöstes Ticket gelangt zurück zur Bearbeitung.&lt;br&gt;□ Ein Ticket wird erst nach User-Bestätigung oder dokumentierter Abschlussregel geschlossen.&lt;br&gt;□ Kennzahlen stimmen mit den vorhandenen Tickets überein.&lt;br&gt;□ Kenneths Services, Finns Testtickets und Annas Request-Typen sind korrekt eingebunden." vertex="1">
          <mxGeometry x="160" y="650" width="1280" height="270" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
